# Runs on the Pi (NOT the NAS) — see software/presence-agent's doc
# comment for why: the backend's own containerized raw ICMP socket is
# unreliable on this household's NAS deployment (Docker's
# ambient-capability propagation to a non-root USER doesn't work here),
# so this Pi-side daemon is the primary presence-detection path, with
# the backend's own blind polling kept running as a fallback for "the
# Pi itself is down" specifically.
#
# Unlike home-info-motion-agent.service, this one does NOT need the
# Wayland session (no screen access) — just the network — so it can
# start as soon as the network is up, no graphical.target dependency.
#
# AmbientCapabilities/CapabilityBoundingSet grant CAP_NET_RAW to this
# one non-root systemd service directly — the standard, reliable way to
# do this on bare Linux (unlike Docker's inconsistent handling, see
# above). Same User= placeholder caveat as the other Pi units — this
# household's real account is a randomized username, not literally
# "kiosk"; see home-info-kiosk.service's header comment for the
# systemctl-edit override this needs.
[Unit]
Description=HomeInformationScreen presence-agent (LAN presence pinging)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kiosk
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
EnvironmentFile=-/etc/home-info-screen/presence-agent.env
ExecStart=/opt/home-info-screen/presence-agent
Restart=always
RestartSec=3
CPUQuota=20%

[Install]
WantedBy=multi-user.target
