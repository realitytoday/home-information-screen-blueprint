# Config for software/presence-agent, read via
# home-info-presence-agent.service's EnvironmentFile. Copy to
# /etc/home-info-screen/presence-agent.env on the Pi and fill in
# PRESENCE_WEBHOOK_URL (chmod 600 — it embeds a token):
#   sudo cp presence-agent.env.example /etc/home-info-screen/presence-agent.env
#   sudo chmod 600 /etc/home-info-screen/presence-agent.env
#   sudo systemctl enable --now home-info-presence-agent

# Full callback URL including ?token=... — copy it straight from the
# admin page's admin site Presence panel (Webhook-URLs card) once
# PRESENCE_WEBHOOK_TOKEN is set in the backend's own deploy/.env. Leave
# blank to run pings locally with no backend reporting (not useful on
# its own — the whole point is reporting back).
PRESENCE_WEBHOOK_URL=

# Where to fetch the current device list (personId -> IP) from — the
# existing admin-editable Anwesenheit config, same source of truth as
# always, no separate copy kept on the Pi.
BACKEND_URL=http://{{SERVER_HOST}}:{{API_PORT}}

# Reuses the kiosk's own already-provisioned API key file.
BACKEND_API_KEY_FILE=/etc/home-info-screen/api-key

# How often to re-fetch the device list and re-ping everyone.
POLL_INTERVAL=60s
