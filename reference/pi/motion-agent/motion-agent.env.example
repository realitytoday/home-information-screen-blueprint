# Config for software/motion-agent, read via home-info-motion-agent.service's
# EnvironmentFile. Copy to /etc/home-info-screen/motion-agent.env on the
# Pi and fill in MOTION_WEBHOOK_URL (chmod 600 — it embeds a token):
#   sudo cp motion-agent.env.example /etc/home-info-screen/motion-agent.env
#   sudo chmod 600 /etc/home-info-screen/motion-agent.env
#   sudo systemctl enable --now home-info-motion-agent

# Full callback URL including ?token=... — copy it straight from the
# admin page's admin site Presence panel (Webhook-URLs card) once
# MOTION_WEBHOOK_TOKEN is set in the backend's own deploy/.env. Leave
# blank to run with screen-power control only, no backend reporting.
MOTION_WEBHOOK_URL=

# BCM GPIO number for the PIR data pin. This household's wiring
# (confirmed 2026-09-14): VCC on header pin 2, GND on pin 6, data on
# pin 12 = BCM GPIO18 (the default below).
GPIO_PIN=18

# How long with no motion before the screen is put to sleep.
IDLE_TIMEOUT=5m

# The Wayland output name to control — confirmed for this household's
# panel via wlr-randr (see docs/HARDWARE.md).
SCREEN_OUTPUT=HDMI-A-1

# Override only if wlopm isn't installed on this Pi (defaults use it —
# confirmed working on real hardware 2026-09-14, see CLAUDE.md). Do NOT
# switch to `wlr-randr --output HDMI-A-1 --off/--on` here — confirmed on
# real hardware that fully disabling the output crashes Chromium's
# rendering surface outright (zygote "Broken pipe", needed a manual
# restart to recover). wlopm blanks backlight/power via the dedicated
# DPMS-style protocol instead, without disabling the output.
# SLEEP_CMD=wlopm --off HDMI-A-1
# WAKE_CMD=wlopm --on HDMI-A-1
